# === Required ===
GEMINI_API_KEY=your-gemini-api-key-here
# Optional: If you want to use Groq fallback models
GROQ_API_KEY=your-groq-api-key-here

# === LLM Model Selection ===
# Supervisor uses strongest model for routing decisions (e.g. gemini-2.5-pro or llama-3.3-70b-versatile)
SUPERVISOR_MODEL=gemini-2.5-pro
# Simpler, cheaper model for support queries (e.g. gemini-2.5-flash or llama-3.1-8b-instant)
SUPPORT_MODEL=gemini-2.5-flash
# Strong model for recommendations (needs product reasoning)
RECOMMENDATION_MODEL=gemini-2.5-pro
# Good structured-output model for order operations
ORDER_MODEL=gemini-2.5-flash
# Lightweight model for silent profiling
PROFILING_MODEL=gemini-2.5-flash

# === Budget Guardrails ===
# Total allowed spend per day (hard stop)
MAX_DAILY_COST=10.0
# Max spend per customer session
MAX_SESSION_COST=2.0
# Max tokens consumed per session before cut-off
MAX_TOKENS_PER_SESSION=50000
# Max API requests per minute per session
MAX_REQUESTS_PER_MINUTE=30
# Warn at this % of daily budget (0.0 - 1.0)
BUDGET_ALERT_PERCENTAGE=0.8
# When true, agent refuses requests once budget is exhausted
HARD_STOP_ENABLED=true

# === Google Cloud ===
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# === Server ===
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=INFO
