# === Required ===
GEMINI_API_KEY=your-gemini-api-key-here
# Optional: Groq fallback models
GROQ_API_KEY=your-groq-api-key-here

# === Database & Checkpointing (Supabase / Postgres) ===
# Local SQLite default:
DATABASE_URL=sqlite+aiosqlite:///./aisle.db
# Production Supabase Connection Pooler (Transaction or Session pooler on port 5432 or 6543):
# DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require

# === CORS & Security ===
CORS_ORIGINS=*
JWT_SECRET=super-secret-aisle-key-change-in-production-12345
JWT_ALGORITHM=HS256

# === LLM Model Selection ===
SUPERVISOR_MODEL=gemini-2.5-flash
SUPPORT_MODEL=gemini-2.5-flash-lite
RECOMMENDATION_MODEL=gemini-2.5-flash
ORDER_MODEL=gemini-2.5-flash-lite
PROFILING_MODEL=gemini-2.5-flash-lite

# === Budget Guardrails ===
MAX_DAILY_COST=10.0
MAX_SESSION_COST=2.0
MAX_TOKENS_PER_SESSION=50000
MAX_REQUESTS_PER_MINUTE=30
BUDGET_ALERT_PERCENTAGE=0.8
HARD_STOP_ENABLED=true

# === Optional: LangSmith Observability & Tracing ===
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
# LANGCHAIN_API_KEY=your_langsmith_api_key
# LANGCHAIN_PROJECT=aisle-ecommerce-agent

# === Server ===
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=INFO
